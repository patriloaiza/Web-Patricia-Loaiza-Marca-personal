# Custom 404 error page (ensures real HTTP 404 status for non-existent URLs)
ErrorDocument 404 /404.html

# Apache / LiteSpeed Configuration for Hostinger (https://soypatricialoaiza.com)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enforce non-www directly over HTTPS (single 301 hop from http(s)://www -> https://non-www)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 2. Enforce HTTPS for non-www traffic
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3. Mark unlisted Privacy Policy page with env var for X-Robots-Tag header
  RewriteCond %{REQUEST_URI} ^/politica-de-privacidad(/|$) [NC]
  RewriteRule ^ - [E=NOINDEX_PRIVACY:1]

  # 4. Direct access to existing static files, directories, or scripts
  # All non-existent paths fall through to Apache/LiteSpeed real HTTP 404 (ErrorDocument /404.html)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# Security & Cache Headers
<IfModule mod_headers.c>
  # Block indexing of legal PDFs strictly
  <FilesMatch "\.(pdf)$">
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>

  # Block indexing of unlisted Privacy Policy page (still returns HTTP 200 for Meta/Facebook Ads validator)
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" env=NOINDEX_PRIVACY
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" env=REDIRECT_NOINDEX_PRIVACY
  
  # Advertise machine-readable resources via RFC 8288 Link header on the homepage
  <Files "index.html">
    Header set Link "</llms.txt>; rel=\"alternate\"; type=\"text/markdown\"; title=\"LLMs Index\", </llms-full.txt>; rel=\"alternate\"; type=\"text/markdown\"; title=\"Full Canonical Context\", </.well-known/ard.json>; rel=\"describedby\"; type=\"application/json\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\""
  </Files>

  # Allow AI bots and search engines to read technical and txt files with permissive CORS
  <FilesMatch "\.(txt|xml|json)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
