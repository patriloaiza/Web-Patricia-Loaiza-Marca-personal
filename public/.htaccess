# Apache / LiteSpeed Configuration for Hostinger (https://soypatricialoaiza.com)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enforce HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Enforce non-www (redirect www.soypatricialoaiza.com to soypatricialoaiza.com)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 3. Direct access to existing static files, directories, or scripts
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Fallback for client-side routing to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security & Cache Headers
<IfModule mod_headers.c>
  # Block indexing of legal PDFs strictly
  <FilesMatch "\.(pdf)$">
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
  
  # Allow AI bots and search engines to read technical and txt files with permissive CORS
  <FilesMatch "\.(txt|xml|json)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
